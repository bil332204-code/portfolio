# Copy these into Vercel → Project → Settings → Environment Variables.
# For local testing with `vercel dev`, copy this file to .env.local and fill it in. Never commit real keys.

# From resend.com → API Keys (sending access is enough)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact messages arrive. Until you verify your domain in Resend,
# this MUST be the same email you signed up to Resend with.
CONTACT_TO_EMAIL=your-resend-account-email@example.com

# Optional. Leave unset to use Resend's test sender (onboarding@resend.dev).
# After verifying bilal-ahmed-builds.cyou in Resend, use something like:
# CONTACT_FROM_EMAIL=Portfolio <hello@bilal-ahmed-builds.cyou>

# Optional. Comma-separated list of sites allowed to use the contact form.
# ALLOWED_ORIGINS=https://bilal-ahmed-builds.cyou,https://www.bilal-ahmed-builds.cyou
